{% liquid
  assign hero = section.settings.hero_image
  assign mobile = section.settings.mobile_image
%}
<section class="b-hero" style="--hero-image:url('{{ hero | image_url: width: 2400 }}')">
  {% if mobile != blank %}
    <style>@media(max-width:640px){#shopify-section-{{ section.id }} .b-hero{--hero-image:url('{{ mobile | image_url: width: 1200 }}')}}</style>
  {% endif %}
  <div class="b-page b-hero__inner" data-reveal>
    {% if section.settings.eyebrow != blank %}<p class="b-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h1 class="b-title">{{ section.settings.heading }}</h1>
    {% if section.settings.copy != blank %}<div class="b-hero__copy rte">{{ section.settings.copy }}</div>{% endif %}
    {% if section.settings.button_label != blank and section.settings.button_link != blank %}<a class="b-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}
  </div>
</section>
{% schema %}
{"name":"BaBBled editorial hero","settings":[{"type":"image_picker","id":"hero_image","label":"Adobe editorial hero image"},{"type":"image_picker","id":"mobile_image","label":"Mobile crop"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Original art by Brooke Howard"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Art that sees what you <em>can’t say.</em>"},{"type":"richtext","id":"copy","label":"Text","default":"<p>Museum-quality art prints for dreamers, seekers, and soft rebels.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Shop original prints"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"BaBBled editorial hero"}]}
{% endschema %}
